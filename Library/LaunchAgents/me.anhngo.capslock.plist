<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Remaps Caps Lock to F18 at every login, for every keyboard, so Hammerspoon
  can bind it to Mission Control (~/.hammerspoon/init.lua). hidutil mappings
  don't survive a reboot on their own, hence the agent. 0x700000039 is Caps
  Lock and 0x70000006D is F18, as HID usage page 7 codes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.anhngo.capslock</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x70000006D}]}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
