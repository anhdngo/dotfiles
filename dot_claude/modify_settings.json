{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merged into ~/.claude/settings.json, which Claude Code and iTerm2 also write
  to. Keys below are defaults for a new machine, set only when missing, so
  changes made in Claude Code stick.
*/ -}}
{{- $s := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $s = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- range $k, $v := dict "effortLevel" "high" "theme" "dark" "attribution" (dict "commit" "" "pr" "") -}}
{{-   if not (hasKey $s $k) }}{{ $_ := set $s $k $v }}{{ end -}}
{{- end -}}
{{- /* A stale Linux path this file used to set; the shell exports the right one */ -}}
{{- if hasKey $s "env" -}}
{{-   $_ := unset $s.env "GODOT_PATH" -}}
{{-   if not $s.env }}{{ $_ := unset $s "env" }}{{ end -}}
{{- end -}}
{{- toPrettyJson $s -}}
