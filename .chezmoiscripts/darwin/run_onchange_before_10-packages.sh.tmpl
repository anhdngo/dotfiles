{{- $profile := default "gamedev" (get . "profile") -}}
{{- $gamedev := eq $profile "gamedev" -}}
{{- $ai := ne $profile "coding-noai" -}}
#!/bin/bash
# Installs Homebrew + packages from .chezmoidata/packages.yaml; re-runs when they change.
set -eu

if [ ! -x /opt/homebrew/bin/brew ]; then
    echo "==> Installing Homebrew"
    # NONINTERACTIVE won't prompt for a password, so cache sudo first
    sudo -v
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

echo "==> Installing Homebrew packages"
brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT
cat > "$brewfile" <<'EOF'
# Take over apps installed by hand instead of failing on them
cask_args adopt: true
{{ range .packages.brew.common -}}
brew {{ . | quote }}
{{ end -}}
{{ if $ai -}}
{{ range .packages.brew.ai -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.brew.casks.common -}}
cask {{ . | quote }}
{{ end -}}
{{ if $gamedev -}}
{{ range .packages.brew.casks.gamedev -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
# One bad entry mustn't stop the dotfiles from being written
brew bundle --file="$brewfile" || echo "warning: some Homebrew packages failed to install - see above" >&2
