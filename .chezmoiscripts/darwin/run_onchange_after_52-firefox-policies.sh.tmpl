#!/bin/bash
# Installs firefox-policies.json (locked extensions) into the Firefox app
# bundle - macOS has no /etc/firefox; Firefox reads policies from
# Contents/Resources/distribution instead. Re-runs when the policies change;
# a Firefox reinstall replaces the bundle, so copy it back by hand after one.
#
# macOS guards app bundles: if the copy is refused, give the terminal "App
# Management" access (System Settings > Privacy & Security) and copy it by
# hand - this script only re-runs when the policies change.
#
# policies: {{ include "firefox-policies.json" | sha256sum }}
set -eu

app=/Applications/Firefox.app
if [ ! -d "$app" ]; then
    echo "warning: $app not found; skipping Firefox policies" >&2
    exit 0
fi

echo "==> Installing Firefox policies"
dest="$app/Contents/Resources/distribution"
if ! { install -d "$dest" && install -m 644 "{{ .chezmoi.sourceDir }}/firefox-policies.json" "$dest/policies.json"; }; then
    echo "warning: could not write $dest/policies.json (App Management permission?)" >&2
fi
