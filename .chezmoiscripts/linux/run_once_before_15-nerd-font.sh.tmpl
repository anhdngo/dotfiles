{{ if .gui -}}
#!/bin/bash
# Installs the JetBrainsMono Nerd Font into ~/.local/share/fonts so the round
# cap that ends the zsh prompt (U+E0B4, see prompt_end in dot_zshrc) actually
# renders. Fedora/Debian ship only the un-patched jetbrains-mono-fonts, and
# powerline-fonts covers agnoster's separators but not that glyph, so we pull
# the Nerd-patched build straight from the ryanoasis release.
#
# GUI-only on purpose: WSL renders through Windows Terminal, which already has
# CaskaydiaCove Nerd Font (choco, see packages.yaml), and a headless server is
# reached from a terminal elsewhere, whose font is what counts.
set -eu

if fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd Font"; then
    exit 0
fi

echo "==> Installing JetBrainsMono Nerd Font"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fontdir="$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
mkdir -p "$fontdir"

curl -fsSL -o "$tmp/JetBrainsMono.zip" \
    "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"
unzip -qo "$tmp/JetBrainsMono.zip" -d "$fontdir" -x "*.md" "LICENSE"

fc-cache -f "$fontdir" >/dev/null
echo "JetBrainsMono Nerd Font installed — set your terminal font to 'JetBrainsMono Nerd Font'"
{{ end -}}
